generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  onboardingProfile OnboardingProfile?
  submissions       Submission[]
  hints             Hint[]
  visualizations    Visualization[]
  streak            Streak?
  progress          UserProgress?

  @@map("users")
}

model OnboardingProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  experienceLevel String
  goals     String
  preferredTopics String  // Changed from String[] to String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmaps  Roadmap[]

  @@map("user_profiles")
}

model Roadmap {
  id         String   @id @default(uuid())
  userId     String
  day        Int
  topic      String
  tasks      String   // Changed from Json to String
  difficulty String
  completed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  user OnboardingProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId])
  @@map("roadmaps")
}

model Submission {
  id        String           @id @default(cuid())
  userId    String
  problemId String
  status    String           // Changed from SubmissionStatus to String
  createdAt DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, problemId, createdAt])
  @@map("submissions")
}

model Hint {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  hintLevel Int
  hintText  String
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, problemId, createdAt])
  @@index([userId, problemId, hintLevel])
  @@map("hints")
}

model Visualization {
  id        String   @id @default(cuid())
  userId    String
  code      String
  input     String
  output    String   // Changed from Json to String
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("visualizations")
}

model Streak {
  id            String   @id @default(cuid())
  userId        String   @unique
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastActiveDate DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("streaks")
}

model DailyChallenge {
  date       DateTime @id
  problemId  String
  difficulty String
  createdAt  DateTime @default(now())

  @@map("daily_challenges")
}

model DailyChallengeCompletion {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@map("daily_challenge_completions")
}

model UserProgress {
  id        String   @id @default(cuid())
  userId    String   @unique
  data      String   // Store the complete progress object as JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_progress")
}

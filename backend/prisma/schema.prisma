generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OnboardingProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  experienceLevel String
  goals     String
  preferredTopics String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roadmaps  Roadmap[]

  @@map("user_profiles")
}

model Roadmap {
  id         String   @id @default(uuid())
  userId     String
  day        Int
  topic      String
  tasks      Json      @map("problems")
  difficulty String
  completed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  onboardingProfile OnboardingProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId])
  @@map("roadmaps")
}

model Submission {
  id        String           @id @default(cuid())
  userId    String
  problemId String
  status    SubmissionStatus
  createdAt DateTime         @default(now())

  @@index([userId, problemId, createdAt])
  @@map("submissions")
}

model Hint {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  hintLevel Int
  hintText  String
  createdAt DateTime @default(now())

  @@index([userId, problemId, createdAt])
  @@index([userId, problemId, hintLevel])
  @@map("hints")
}

model Visualization {
  id        String   @id @default(cuid())
  userId    String
  code      String
  input     String
  output    Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("visualizations")
}

model Streak {
  id            String   @id @default(cuid())
  userId        String   @unique
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastActiveDate DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("streaks")
}

enum SubmissionStatus {
  passed
  failed
}

model DailyChallenge {
  date       DateTime @id
  problemId  String
  difficulty String
  createdAt  DateTime @default(now())

  @@map("daily_challenges")
}

model DailyChallengeCompletion {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@map("daily_challenge_completions")
}

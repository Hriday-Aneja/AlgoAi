generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  onboardingProfile OnboardingProfile?
  submissions       Submission[]
  hints             Hint[]
  visualizations    Visualization[]
  streak            Streak?
  progress          UserProgress?
  problemProgress   UserProblemProgress[]
  userBossBattles   UserBossBattle[]

  @@map("users")
}

model OnboardingProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  experienceLevel String
  goals     String
  preferredTopics String  // Changed from String[] to String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmaps  Roadmap[]

  @@map("user_profiles")
}

model Roadmap {
  id         String   @id @default(uuid())
  userId     String
  day        Int
  topic      String
  tasks      String   // Changed from Json to String
  difficulty String
  completed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  user OnboardingProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId])
  @@map("roadmaps")
}

model Submission {
  id        String           @id @default(cuid())
  userId    String
  problemId String
  status    String           // Changed from SubmissionStatus to String
  createdAt DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, problemId, createdAt])
  @@map("submissions")
}

model Hint {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  hintLevel Int
  hintText  String
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, problemId, createdAt])
  @@index([userId, problemId, hintLevel])
  @@map("hints")
}

model Visualization {
  id        String   @id @default(cuid())
  userId    String
  code      String
  input     String
  output    String   // Changed from Json to String
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("visualizations")
}

model Streak {
  id            String   @id @default(cuid())
  userId        String   @unique
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastActiveDate DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("streaks")
}

model DailyChallenge {
  date       DateTime @id
  problemId  String
  difficulty String
  createdAt  DateTime @default(now())

  @@map("daily_challenges")
}

model DailyChallengeCompletion {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@map("daily_challenge_completions")
}

model UserProgress {
  id        String   @id @default(cuid())
  userId    String   @unique
  data      Json     // Store the complete progress object as JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_progress")
}

model UserProblemProgress {
  id          String   @id @default(cuid())
  userId      String
  problemId   String
  topic       String[]
  difficulty  String
  status      String
  timeTaken   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId])
  @@map("user_problem_progress")
}

model DailyBoss {
  id         String   @id @default(cuid())
  date       String
  topic      String
  difficulty String
  bossName   String
  order      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userBossBattles UserBossBattle[]

  @@unique([date, difficulty], name: "date_difficulty")
  @@index([date])
  @@map("daily_bosses")
}

model UserBossBattle {
  id           String   @id @default(cuid())
  userId       String
  dailyBossId  String
  problemId    String
  hp           Int      @default(100)
  defeated     Boolean  @default(false)
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyBoss DailyBoss @relation(fields: [dailyBossId], references: [id], onDelete: Cascade)
  problem   Problem   @relation(fields: [problemId], references: [id], onDelete: NoAction)

  @@unique([userId, dailyBossId], name: "user_daily_boss")
  @@index([userId])
  @@map("user_boss_battles")
}

model Problem {
  id              String   @id
  title           String
  topic           String
  difficulty      String

  description     String

  // Legacy single-language starter code. Kept for backward compatibility —
  // used as the last-resort fallback when a language has no entry in
  // `starterCodeByLang` (e.g. older seeded problems).
  starterCode     String?

  // Per-language starter code, e.g. { "javascript": "...", "python": "..." }
  // Keys are `SupportedLanguage` values (see backend/src/types/problem.types.ts).
  starterCodeByLang  Json?

  // Per-language expected function name/signature, e.g.
  // { "javascript": { "functionName": "twoSum", "dataStructure": "array" }, ... }
  // See backend/src/types/problem.types.ts for the shape.
  functionSignatures Json?

  tags            Json?
  examples        Json?
  constraints     Json?
  hints           Json?
  testCases       Json?

  acceptance      Float?
  likes           Int?

  timeComplexity  String?
  spaceComplexity String?

  userBossBattles UserBossBattle[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([topic])
  @@map("problems")
}
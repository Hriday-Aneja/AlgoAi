# ═══════════════════════════════════════════════════════════════════════════════
# Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════════
#
# IMPORTANT: 
# 1. Copy this file to .env (in the same directory):
#    cp .env.example .env
#
# 2. Fill in the actual values for your environment
#
# 3. DO NOT commit .env to version control (it's in .gitignore)
#
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Server Configuration ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ─── Code Execution Provider (JDoodle) ───────────────────────────────────────
# Get credentials from https://www.jdoodle.com/compiler-api
JDOODLE_CLIENT_ID=your_jdoodle_client_id
JDOODLE_CLIENT_SECRET=your_jdoodle_client_secret

# ─── Supabase Configuration (REQUIRED) ───────────────────────────────────────
#
# Get these values from https://app.supabase.com/
# 1. Go to your project
# 2. Click Settings → API
# 3. Copy values from "Project URL" and "Anon Key"
#
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── AI Provider Selection (REQUIRED) ────────────────────────────────────────
#
# Choose: "gemini" or "openai"
#
AI_PROVIDER=gemini

# ─── Google Gemini Configuration (Required if AI_PROVIDER=gemini) ────────────
#
# Get your Gemini API key from:
# https://makersuite.google.com/app/apikey
#
# Choose a model:
# - gemini-1.5-flash   (faster, cheaper, good for most tasks)
# - gemini-1.5-pro     (more capable, higher cost)
# - gemini-1.0-pro     (older model, lower cost)
#
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ─── OpenAI Configuration (Required if AI_PROVIDER=openai) ──────────────────
#
# Get your API key from: https://platform.openai.com/api-keys
#
# Choose a model:
# - gpt-4-turbo        (most capable, higher cost)
# - gpt-4              (capable, higher cost)
# - gpt-3.5-turbo      (budget friendly, still very capable)
#
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo

# ─── Optional Configuration ──────────────────────────────────────────────────
#
# Custom prefix for onboarding prompts to the AI service
#
ONBOARDING_PROMPT_PREFIX=Generate a 7-14 day DSA roadmap based on user level, goals, and topics.


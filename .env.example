# Frontend Gemini
VITE_GEMINI_API_KEY=your_gemini_api_key
VITE_GEMINI_MODEL=gemini-2.5-flash
VITE_API_URL=http://localhost:3001/api

# Frontend code-execution endpoint
# Defaults to VITE_API_URL + /execute. Keep this only if you want a custom route.
VITE_EXECUTE_API=http://localhost:3001/api/execute
